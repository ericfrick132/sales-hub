FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiar solo los proyectos necesarios para el worker
COPY ["src/SalesHub.Workers/SalesHub.Workers.csproj", "src/SalesHub.Workers/"]
COPY ["src/SalesHub.Infrastructure/SalesHub.Infrastructure.csproj", "src/SalesHub.Infrastructure/"]
COPY ["src/SalesHub.Core/SalesHub.Core.csproj", "src/SalesHub.Core/"]
RUN dotnet restore "src/SalesHub.Workers/SalesHub.Workers.csproj"

COPY src/ src/
RUN dotnet publish "src/SalesHub.Workers/SalesHub.Workers.csproj" -c Release -o /app/publish

# ==============
# Imagen final (más liviana que la de la API porque no necesita nginx)
# ==============
FROM mcr.microsoft.com/dotnet/runtime:8.0 AS final
WORKDIR /app

# Instalar dependencias de Playwright + Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Instalar Chromium para Playwright
RUN dotnet tool install --global Microsoft.Playwright.CLI
ENV PATH="$PATH:/root/.dotnet/tools"
RUN playwright install chromium

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "SalesHub.Workers.dll"]
