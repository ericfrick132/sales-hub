{
  "manifest_version": 3,
  "name": "IG Follow Lista",
  "version": "1.0.0",
  "description": "Sigue de a una las cuentas de una lista, despacio y con tope diario.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "IG Follow Lista" }
}
