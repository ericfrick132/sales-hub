# ============================================================
# CONFIGURACIÓN PARA VENDEDORES - Worker de Instagram
# ============================================================
# 
# 1. Instalá Docker Desktop en tu PC
#    https://docs.docker.com/desktop/setup/install/windows-install/
#
# 2. Copiá este archivo como ".env.worker" (sin "example")
#
# 3. Completa SOLO la DB_CONNECTION_STRING (te la da Eric)
#
# 4. Abrí una terminal en esta carpeta y ejecutá:
#    docker compose -f docker-compose.worker.yml up -d
#
# 5. Para ver los logs:
#    docker compose -f docker-compose.worker.yml logs -f
#
# 6. Para detenerlo:
#    docker compose -f docker-compose.worker.yml down
# ============================================================

# --- Conexión a la base de datos central (DigitalOcean) ---
# Te lo da Eric. Es algo como:
# Host=64.227.3.140;Port=5432;Database=saleshub;Username=worker_user;Password=...
DB_CONNECTION_STRING=Host=64.227.3.140;Port=5432;Database=saleshub;Username=worker_user;Password=tu_password

# --- Límites de Instagram (por cuenta) ---
MAX_DM_PER_HOUR=20
MAX_SCRAPE_PER_HOUR=100
SCRAPER_INTERVAL_MINUTES=60

# --- Proxy (opcional, ej: BrightData) ---
# Si no usás proxy, dejalo vacío
INSTAGRAM_PROXY_URL=
