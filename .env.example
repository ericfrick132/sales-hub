# === Required ===
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EVOLUTION_BASE_URL=http://64.227.3.140:8080
EVOLUTION_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JWT_SIGNING_KEY=replace-with-a-random-string-at-least-32-characters-long
ADMIN_EMAIL=eric@example.com
ADMIN_PASSWORD=change-on-first-login

# === Optional ===
GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=

# Comma-separated list of origins allowed by CORS in production
CORS_ORIGINS=http://localhost:5173,http://localhost

# === Posteos: generador de imagen IA (GPT Image por default, Grok como alt) ===
# Proveedor: "openai" (recomendado) | "grok"
IMAGEGEN_PROVIDER=openai
# API key del proveedor (OpenAI sk-... o xAI). SIN esto, "Generar imagen" devuelve error.
IMAGEGEN_API_KEY=
# Modelo exacto. OpenAI: gpt-image-1.5 · Grok: grok-imagine-image
IMAGEGEN_MODEL=gpt-image-1.5
# Base pública de la API (sirve /api/posteos/assets/{id}.png). Prod: https://api.sales.efcloud.tech
IMAGEGEN_PUBLIC_BASE_URL=http://localhost:8080

# === Instagram (Playwright-based scraper) ===
# Encryption key for Instagram passwords (32 chars min)
SALESHUB_INSTAGRAM_ENCRYPTION_KEY=change-me-to-a-32-char-key!!
# Optional proxy for Instagram browser
# INSTAGRAM__PROXY_URL=http://user:pass@host:port


