# /opt/sales-hub/.env on the droplet
# All values consumed by SalesHub.Api (which also runs the BackgroundServices when SALESHUB_RUN_WORKERS=true)

# ===== Postgres (managed cluster dbaas-db-3146727, database "saleshub") =====
ConnectionStrings__Default=Host=dbaas-db-3146727-do-user-23398434-0.e.db.ondigitalocean.com;Port=25060;Database=saleshub;Username=saleshub;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true

# ===== JWT =====
Jwt__Issuer=sales-hub
Jwt__Audience=sales-hub
Jwt__SigningKey=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS

# ===== Apify =====
Apify__Token=apify_api_REPLACE_ME

# ===== Evolution (corre en este mismo droplet) =====
Evolution__BaseUrl=http://evolution-api:8080
Evolution__ApiKey=REPLACE_ME

# ===== Google =====
Google__OAuthClientId=
Google__PlacesApiKey=

# ===== CORS — frontend en GitHub Pages =====
Cors__Origins=https://sales.efcloud.tech

# ===== Seed admin =====
Seed__AdminEmail=eric@efcloud.tech
Seed__AdminPassword=REPLACE_ME

# ===== Posteos / contenido social =====
# Claude (generación de concepto/caption/inspiración). Tag de costo "social".
Claude__ApiKey=sk-ant-REPLACE_ME
# Imagen IA (carruseles/posts). Proveedor: openai | grok | gemini | pollinations(gratis).
ImageGen__Provider=openai
ImageGen__ApiKey=REPLACE_ME
ImageGen__Model=gpt-image-1.5
ImageGen__PublicBaseUrl=https://api.sales.efcloud.tech
# Distribución Buffer (API oficial, cuentas business). 1 token del dashboard.
Buffer__Token=REPLACE_ME
# Video IA (fal.ai, API key, headless → corre en el droplet). Key en https://fal.ai/dashboard/keys
Fal__ApiKey=REPLACE_ME
Fal__VideoModel=fal-ai/bytedance/seedance/v1/pro/text-to-video
Fal__PublicBaseUrl=https://api.sales.efcloud.tech
# Distribución Warmr (device real). "handoff" = cola para subida manual a Cloud Drop.
Warmr__Mode=handoff

# ===== Instagram (Playwright-based scraper) =====
SALESHUB_INSTAGRAM_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_KEY
# Optional proxy for Instagram browser
# Instagram__ProxyUrl=http://user:pass@host:port

# ===== Instagram Structure Analyzer (LLM) =====
# Usa DeepSeek por defecto (más barato). También soporta OpenAI.
# InstagramLlm__ApiKey=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# InstagramLlm__Endpoint=https://api.deepseek.com/v1/chat/completions
# InstagramLlm__Model=deepseek-chat
# InstagramLlm__AnalysisIntervalHours=24

